{
  "manifest_version": 3,
  "name": "SSearch",
  "version": "1.0",
  "description": "快速进行Dork搜索",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": ["tabs", "activeTab"],
  "content_security_policy": {
    "extension": {
      "script-src": "'self'"
    }
  }
}
